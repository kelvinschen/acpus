{
  "name": "acpus-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:clean": "pnpm clean && pnpm build",
    "typecheck": "pnpm --filter @acpus/core build && pnpm -r typecheck",
    "test": "vitest run --typecheck --maxWorkers=20",
    "test:watch": "vitest",
    "test:type": "vitest run --typecheck.only --project type-contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:regression": "vitest run --project regression",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "changeset publish",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@acpus/agent-executor": "workspace:*",
    "@acpus/loader": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@acpus/tasks": "workspace:*",
    "@acpus/workflow-compiler": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.15.30",
    "acpus": "workspace:*",
    "eslint": "^10.6.0",
    "slash": "^3.0.0",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  }
}
