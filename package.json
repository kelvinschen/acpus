{
  "name": "acpus-rs-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "acpus": "cargo run -q -p acpus-cli --",
    "acpus:release": "./target/release/acpus",
    "build": "cargo build --workspace --release && pnpm --filter @acpus/tui build",
    "typecheck": "pnpm --filter @acpus/tui typecheck",
    "test": "cargo test --workspace && vitest run packages/tui/test",
    "clean": "cargo clean && pnpm --filter @acpus/tui clean"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "tsx": "^4.20.3",
    "vitest": "^4.1.8"
  }
}
