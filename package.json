{
  "name": "acpus-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs workspace",
    "build:clean": "pnpm clean && pnpm build",
    "check": "node scripts/check.mjs",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.vitest.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "test:type": "vitest run --typecheck.only --project type-contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:regression": "vitest run --project regression",
    "test:dist": "node scripts/verify-dist.js",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-acpus-skill-version.mjs && pnpm install --lockfile-only",
    "ci:publish": "pnpm check release && changeset publish",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.1",
    "acpus": "workspace:*",
    "esbuild": "^0.28.1",
    "knip": "^6.26.0",
    "semver": "^7.8.4",
    "slash": "^3.0.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
