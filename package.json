{
  "name": "acpus-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @acpus/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "acpus": "node packages/cli/dist/index.js",
    "mock-agent": "node packages/mock-agent/dist/index.js",
    "publish:preflight": "node scripts/preflight-publish.mjs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "execa": "^9.6.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
