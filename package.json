{
  "name": "acpus",
  "version": "0.0.0",
  "private": false,
  "description": "Runtime-driven workflow orchestrator for ACP agents",
  "keywords": [
    "acpx",
    "workflow",
    "orchestrator",
    "agent",
    "cli"
  ],
  "license": "MIT",
  "author": "kkkyran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinschen/acpus.git"
  },
  "homepage": "https://github.com/kelvinschen/acpus#readme",
  "bugs": {
    "url": "https://github.com/kelvinschen/acpus/issues"
  },
  "type": "module",
  "bin": {
    "acpus": "dist/cli.mjs"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e:fake": "vitest run test/e2e/fake",
    "test:e2e:real": "RUN_REAL_ACPX_E2E=1 vitest run test/e2e/real",
    "generate:schema": "tsx src/schema/generate-json-schema.ts",
    "validate": "npm run typecheck && npm run test && npm run generate:schema && npm run build"
  },
  "dependencies": {
    "acpx": "^0.10.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "ink": "^7.0.5",
    "jsonrepair": "^3.14.0",
    "kleur": "^4.1.5",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.16",
    "ink-testing-library": "^4.0.0",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
