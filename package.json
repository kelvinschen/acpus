{
  "name": "acpus-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @acpus/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:regression": "vitest run --project regression --passWithNoTests",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "pnpm publish:preflight && changeset publish",
    "acpus": "node packages/cli/dist/index.js",
    "mock-agent": "node packages/mock-agent/dist/index.js",
    "publish:preflight": "node scripts/preflight-publish.mjs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.15.30",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "execa": "^9.6.0",
    "tsx": "^4.20.3",
    "vitest": "^4.1.8"
  }
}
