{
  "schemaVersion": "acpus.workflow/v1",
  "name": "bugfix-loop",
  "description": "Bugfix workflow with a bounded workflow-level loop.",
  "root": "plan",
  "inputs": {
    "task": { "type": "string", "default": "" },
    "cwd": { "type": "path", "default": "." }
  },
  "roles": {
    "planner": { "category": "planning", "agent": "claude", "mode": "readOnly" },
    "implementer": { "category": "implementation", "agent": "trae", "mode": "edit" },
    "validator": { "category": "validation", "agent": "aiden", "mode": "readOnly" }
  },
  "limits": {
    "stageTimeoutMinutes": 60
  },
  "stages": [
    {
      "id": "plan",
      "kind": "agentTask",
      "role": "planner",
      "variables": [
        { "name": "task", "source": "input.task" }
      ],
      "prompt": "Plan the smallest safe bugfix for this task:\n\n${task}"
    },
    {
      "id": "implement",
      "kind": "agentTask",
      "role": "implementer",
      "dependsOn": ["plan"],
      "variables": [
        { "name": "task", "source": "input.task" },
        { "name": "plan", "source": "outputs.plan.summary" }
      ],
      "prompt": "Implement the initial bugfix.\n\nTask:\n${task}\n\nPlan:\n${plan}"
    },
    {
      "id": "quality_loop",
      "kind": "loop",
      "dependsOn": ["implement"],
      "maxRounds": 2,
      "body": {
        "root": "validate",
        "output": "validate",
        "stages": [
          {
            "id": "validate",
            "kind": "agentTask",
            "role": "validator",
            "variables": [
              { "name": "task", "source": "input.task" },
              { "name": "implementation", "source": "outputs.implement.summary" },
              { "name": "previousFindings", "source": "loop.previous.output.findings", "transform": [{ "fn": "default", "args": { "value": [] } }, { "fn": "json" }] }
            ],
            "prompt": "Validate the bugfix and decide whether another loop round is needed.\n\nTask:\n${task}\n\nImplementation:\n${implementation}\n\nPrevious findings:\n${previousFindings}\n\nReturn validation output with data.needsAnotherRound set to true only for blocking findings."
          }
        ]
      },
      "continueWhen": { "source": "loop.current.output.data.needsAnotherRound", "op": "eq", "value": true },
      "onExhausted": "blocked"
    },
    {
      "id": "gate",
      "kind": "gate",
      "dependsOn": ["quality_loop"]
    }
  ]
}
