{
  "schemaVersion": "acpx-workflow-orchestrator.workflow/v1",
  "name": "read-only-multi-lane-oneof-default",
  "root": "review_items",
  "inputs": {
    "task": {
      "type": "string",
      "default": "Route each item to exactly one read-only review lane."
    },
    "items": {
      "type": "array<json>",
      "default": [
        {
          "path": "src/runtime/scheduler.ts",
          "area": "runtime"
        },
        {
          "path": "src/schema/workflow-spec.ts",
          "area": "schema"
        },
        {
          "path": "README.md",
          "area": "other"
        }
      ]
    }
  },
  "roles": {
    "runtime_reviewer": {
      "category": "review",
      "agent": "pi",
      "mode": "readOnly"
    },
    "schema_reviewer": {
      "category": "review",
      "agent": "aiden",
      "mode": "readOnly"
    },
    "general_reviewer": {
      "category": "review",
      "agent": "claude",
      "mode": "readOnly"
    },
    "review_reducer": {
      "category": "review",
      "agent": "aiden",
      "mode": "readOnly"
    }
  },
  "limits": {
    "stageTimeoutMinutes": 45
  },
  "stages": [
    {
      "id": "review_items",
      "kind": "fanout",
      "items": {
        "source": "input.items"
      },
      "limits": {
        "maxConcurrency": 3,
        "maxFanoutItems": 12
      },
      "fanoutPolicy": {
        "allowPartial": true,
        "minCompletedRatio": 0.8,
        "maxBlockedItems": 2
      },
      "variables": [
        {
          "name": "task",
          "source": "input.task"
        },
        {
          "name": "item",
          "source": "item",
          "transform": [
            {
              "fn": "json"
            }
          ]
        }
      ],
      "prompt": "Review the routed item for task-relevant issues.\n\nTask:\n${task}\n\nItem:\n${item}",
      "laneGroups": [
        {
          "id": "area_route",
          "mode": "oneOf",
          "lanes": [
            {
              "id": "runtime",
              "role": "runtime_reviewer",
              "when": {
                "source": "item.area",
                "op": "eq",
                "value": "runtime"
              }
            },
            {
              "id": "schema",
              "role": "schema_reviewer",
              "when": {
                "source": "item.area",
                "op": "eq",
                "value": "schema"
              }
            },
            {
              "id": "general",
              "role": "general_reviewer",
              "default": true
            }
          ]
        }
      ]
    },
    {
      "id": "reduce_findings",
      "kind": "reduce",
      "mode": "agent",
      "role": "review_reducer",
      "from": "review_items",
      "dependsOn": [
        "review_items"
      ],
      "variables": [
        {
          "name": "results",
          "source": "outputs.review_items.summary"
        }
      ],
      "prompt": "Merge and deduplicate these routed review results:\n\n${results}"
    },
    {
      "id": "gate",
      "kind": "gate",
      "dependsOn": [
        "reduce_findings"
      ]
    }
  ]
}
