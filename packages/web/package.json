{
  "name": "@acpus/web",
  "version": "0.4.2",
  "type": "module",
  "description": "Acpus WebUI — local operator console for run observation and control.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .static-viz-build tsconfig.build.tsbuildinfo",
    "dev": "vite --config vite.config.ts"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@acpus/workflow-compiler": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "effect": "4.0.0-rc.111",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.75.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/beautiful-mermaid": "^0.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.503.0",
    "markdown-it": "^15.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-json-view-lite": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
