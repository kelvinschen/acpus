{
  "name": "@acpus/tasks",
  "version": "0.1.1",
  "type": "module",
  "description": "Reusable Acpus task package.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    "./git": {
      "development": "./src/git.ts",
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
