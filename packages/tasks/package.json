{
  "name": "@acpus/tasks",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "Reusable Acpus task package.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./git": {
      "development": "./src/git.ts",
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
