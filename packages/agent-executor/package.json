{
  "name": "@acpus/agent-executor",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Acpus acpx-backed ACP agent turn execution.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
