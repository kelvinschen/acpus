{
  "name": "@acpus/tui",
  "version": "0.5.3",
  "description": "Terminal visualizer for Acpus workflow runs",
  "keywords": [
    "acp",
    "workflow",
    "terminal",
    "tui",
    "orchestrator"
  ],
  "license": "MIT",
  "author": "kkkyran",
  "homepage": "https://github.com/kelvinschen/acpus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinschen/acpus.git",
    "directory": "packages/tui"
  },
  "bugs": {
    "url": "https://github.com/kelvinschen/acpus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.tsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serve": {
      "development": "./src/serve.ts",
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@wterm/dom": "0.3.0",
    "ink": "^6.8.0",
    "node-pty": "1.2.0-beta.13",
    "react": "^19.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1"
  }
}
