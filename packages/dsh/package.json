{
  "name": "@acpus/dsh",
  "version": "0.0.2",
  "type": "module",
  "description": "Acpus Supervisor mode for DeepSeek Harness.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./supervisor": {
      "development": "./src/supervisor.ts",
      "types": "./dist/supervisor.d.ts",
      "default": "./dist/supervisor.js"
    },
    "./client": {
      "development": "./src/client/index.tsx",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    },
    "./projection": {
      "development": "./src/remote/types.ts",
      "types": "./dist/remote/types.d.ts",
      "default": "./dist/remote/types.js"
    },
    "./preset": {
      "development": "./src/preset/index.ts",
      "types": "./dist/preset/index.d.ts",
      "default": "./dist/preset/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "acp-agent",
    "preset",
    "cordis.patch.yml",
    "assets",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "knowledge:build": "node scripts/generate-supervisor-preset.mjs",
    "knowledge:check": "node scripts/generate-supervisor-preset.mjs --check",
    "knowledge:validate": "node scripts/validate-knowledge-examples.mjs",
    "remote:generate": "node scripts/remote-artifacts.mjs generate",
    "remote:check": "node scripts/remote-artifacts.mjs check",
    "build": "node scripts/generate-supervisor-preset.mjs && tsc -b tsconfig.build.json && node scripts/remote-artifacts.mjs publish && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@acpus/expression": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@acpus/workflow-compiler": "workspace:*",
    "@deepseek-ai/dsh-acp": "0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
