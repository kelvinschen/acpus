{
  "agents": {
    "my-agent": "my-acp-server --stdio"
  },
  "presets": {
    "deep-coder": {
      "guidance": "Complex implementation and debugging",
      "agent": {
        "use": "codex",
        "model": "gpt-5.6-sol"
      }
    }
  },
  "authoring": {
    "agentScale": "medium"
  },
  "hooks": {
    "run.completed": [
      {
        "id": "record-completion",
        "command": "mkdir -p .acpus/hook-samples && cat > .acpus/hook-samples/last-run-completed.json",
        "timeout": "10s"
      }
    ],
    "node.failed": [
      {
        "id": "record-failed-agent",
        "match": { "kind": "agent" },
        "command": "mkdir -p .acpus/hook-samples && cat > .acpus/hook-samples/last-agent-failure.json",
        "timeout": "10s"
      }
    ]
  }
}
