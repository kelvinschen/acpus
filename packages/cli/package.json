{
  "name": "acpus",
  "version": "0.6.0-alpha.5",
  "type": "module",
  "description": "Acpus CLI for TypeScript workflow validation and durable run admission.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "acpus": "./dist/cli.js"
  },
  "exports": {
    "./core": {
      "development": "./src/authoring/core.ts",
      "types": "./dist/authoring/core.d.ts",
      "default": "./dist/authoring/core.js"
    },
    "./expression": {
      "development": "./src/authoring/expression.ts",
      "types": "./dist/authoring/expression.d.ts",
      "default": "./dist/authoring/expression.js"
    },
    "./tasks/git": {
      "development": "./src/authoring/tasks/git.ts",
      "types": "./dist/authoring/tasks/git.d.ts",
      "default": "./dist/authoring/tasks/git.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.fixtures.json --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@acpus/tasks": "workspace:*",
    "@acpus/web": "workspace:*",
    "@acpus/workflow-compiler": "workspace:*",
    "@clack/prompts": "^1.6.0",
    "commander": "^15.0.0",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
