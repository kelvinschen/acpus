{
  "name": "acpus",
  "version": "0.4.1",
  "description": "Local durable workflow runner for ACP agents",
  "keywords": [
    "acp",
    "acpx",
    "agent",
    "workflow",
    "orchestrator",
    "cli"
  ],
  "license": "MIT",
  "author": "kkkyran",
  "homepage": "https://github.com/kelvinschen/acpus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinschen/acpus.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/kelvinschen/acpus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "acpus": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@acpus/runtime": "workspace:*",
    "@acpus/tui": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
