{
  "name": "@acpus/runtime",
  "version": "0.6.0",
  "description": "Local durable runtime and Run Supervisor for Acpus workflows",
  "keywords": [
    "acp",
    "acpx",
    "workflow",
    "runtime",
    "orchestrator"
  ],
  "license": "MIT",
  "author": "kkkyran",
  "homepage": "https://github.com/kelvinschen/acpus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinschen/acpus.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/kelvinschen/acpus/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@marcbachmann/cel-js": "^7.6.1",
    "acpx": "0.10.0",
    "ajv": "^8.20.0",
    "execa": "^9.6.0",
    "hono": "^4.7.0",
    "jsonrepair": "^3.14.0",
    "p-limit": "^6.2.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@acpus/mock-agent": "workspace:*",
    "@types/node": "^22.15.30",
    "@types/proper-lockfile": "^4.1.4"
  }
}
