{
  "name": "@acpus/runtime",
  "version": "0.9.0-alpha.7",
  "type": "module",
  "description": "Acpus local durable runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@acpus/agent-executor": "workspace:*",
    "@acpus/loader": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "jsonrepair": "^3.14.1",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@acpus/workflow-compiler": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
