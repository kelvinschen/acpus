{
  "name": "@acpus/runtime",
  "version": "0.9.0-alpha.2",
  "type": "module",
  "description": "Acpus local durable runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/agent-executor": "workspace:*",
    "@acpus/loader": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/tasks": "workspace:*",
    "jsonrepair": "^3.14.1",
    "neverthrow": "^8.2.0",
    "p-queue": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
