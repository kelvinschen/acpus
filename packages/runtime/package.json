{
  "name": "@acpus/runtime",
  "version": "0.8.0-alpha",
  "private": true,
  "type": "module",
  "description": "Acpus local durable runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/agent-executor": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/tasks": "workspace:*",
    "jsonrepair": "^3.14.1",
    "neverthrow": "^8.2.0",
    "p-queue": "^9.3.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
