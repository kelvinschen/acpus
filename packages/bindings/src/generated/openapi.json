      "AgentToolCallTelemetry": {
        "type": "object",
        "required": [
          "toolCallId",
          "startedAt",
          "updatedAt"
        ],
        "properties": {
          "completedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "toolCallId": {
            "type": "string"
