          },
          "name": {
            "type": "string"
          },
          "outputs": {},
          "root": {
            "$ref": "#/components/schemas/IrNode"
          },
          "runtimeInput": {},
          "source": {
            "$ref": "#/components/schemas/IrSource"
          }
        }
      },
      "AgentAttemptTelemetry": {
        "type": "object",
        "required": [
          "attempt",
          "state",
          "startedAt",
          "updatedAt",
          "tools"
        ],
        "properties": {
          "acpxRecordId": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentContextUsage"
              }
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "input": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentIoPreview"
              }
            ]
          },
          "output": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentIoPreview"
              }
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/AgentAttemptTelemetryState"
          },
          "tokenUsage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AgentTokenUsage"
              }
            ]
          },
          "tools": {
            "$ref": "#/components/schemas/AgentToolsTelemetry"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "AgentAttemptTelemetryState": {
        "type": "string",
        "enum": [
          "running",
          "completed",
          "failed",
          "paused",
          "cancelled"
        ]
      },
      "AgentContextUsage": {
        "type": "object",
        "required": [
          "used",
          "size",
          "updatedAt"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "updatedAt": {
            "type": "string"
          },
          "used": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AgentIoPreview": {
        "type": "object",
        "required": [
          "preview",
          "truncated",
          "originalBytes",
          "headBytes"
        ],
        "properties": {
          "artifactRef": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/String"
              }
            ]
          },
          "headBytes": {
            "type": "integer",
            "minimum": 0
          },
          "originalBytes": {
            "type": "integer",
            "minimum": 0
          },
          "preview": {
            "type": "string"
          },
          "tailBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "AgentPolicy": {
        "type": "string",
        "enum": [
          "read",
          "full"
        ]
      },
      "AgentSpec": {
        "type": "object",
        "properties": {
          "cwd": {},
          "env": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/AgentPolicy"
          },
          "type": {
            "$ref": "#/components/schemas/AgentType"
          },
          "use": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AgentTelemetry": {
        "type": "object",
        "required": [
          "currentAttempt",
          "attempts"
        ],
        "properties": {
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentAttemptTelemetry"
            }
          },
          "currentAttempt": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AgentTokenUsage": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "cachedReadTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "cachedWriteTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "inputTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "outputTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "source": {
            "type": "string"
          },
          "thoughtTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "totalTokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
