{
  "name": "acpus",
  "version": "0.6.0-alpha",
  "private": true,
  "type": "module",
  "description": "Acpus CLI and local durable runtime for TypeScript workflows.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "acpus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "commander": "^15.0.0",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
