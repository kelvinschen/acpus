{
  "name": "@acpus/workflow-compiler",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "description": "Acpus workflow module compiler and frozen workflow preparation.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/eslint-plugin": {
      "development": "./src/internal/eslint-plugin/index.ts",
      "types": "./dist/internal/eslint-plugin/index.d.ts",
      "default": "./dist/internal/eslint-plugin/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit && pnpm typecheck:fixtures",
    "typecheck:fixtures": "tsgo -p test/tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@acpus/tasks": "workspace:*",
    "@types/node": "^22.15.30",
    "neverthrow": "^8.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "slash": "^3.0.0"
  }
}
