{
  "name": "@acpus/workflow-compiler",
  "version": "0.3.4",
  "type": "module",
  "description": "Acpus workflow module compiler and frozen workflow preparation.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:fixtures",
    "typecheck:fixtures": "tsc -p test/tsconfig.json --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@acpus/owned-process": "workspace:*",
    "@acpus/loader": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@types/node": "^22.20.1",
    "effect": "4.0.0-rc.111",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "slash": "^3.0.0",
    "tsx": "^4.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
