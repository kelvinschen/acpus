{
  "name": "@acpus/workflow-compiler",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "description": "Acpus workflow module compiler and frozen workflow preparation.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:fixtures",
    "typecheck:fixtures": "tsc -p test/tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/loader": "workspace:*",
    "@acpus/core": "workspace:*",
    "@acpus/expression": "workspace:*",
    "@types/node": "^22.15.30",
    "neverthrow": "^8.2.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "slash": "^3.0.0",
    "tsx": "^4.22.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kelvinschen/acpus"
  }
}
