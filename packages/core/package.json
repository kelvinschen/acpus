{
  "name": "@acpus/core",
  "version": "0.8.0-core-alpha",
  "private": true,
  "type": "module",
  "description": "Acpus TypeScript Workflow Core: Schema bridge, Acpus Expr IR, zx/core-backed Task command wrapper, authoring DSL, and validator.",
  "keywords": [
    "acpus",
    "workflow",
    "compiler",
    "schema",
    "ir"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "development": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./workflow": {
      "development": "./src/workflow.ts",
      "types": "./dist/workflow.d.ts",
      "default": "./dist/workflow.js"
    },
    "./runtime": {
      "development": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./ir": {
      "development": "./src/ir.ts",
      "types": "./dist/ir.d.ts",
      "default": "./dist/ir.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acpus/expression": "workspace:*",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30"
  }
}
