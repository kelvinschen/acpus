{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreIssues": {
    // Vitest loads this configuration by convention; its default export is the
    // configuration payload rather than a statically imported API symbol.
    "vitest.config.ts": ["exports"],
    // taskkill.exe is a Windows system executable, not an npm binary.
    "scripts/test.mjs": ["binaries"]
  },
  "workspaces": {
    ".": {
      // Package tests are explicit entries below, so keep the root scan limited
      // to test/tooling entry points instead of traversing user workflows and
      // agent assets.
      "entry": [
        "vitest.config.ts"
      ],
      "project": [],
      "vitest": false
    },
    "packages/*": {
      "entry": ["test/**/*.{test,test-d}.{ts,tsx}"],
      "project": [
        "src/**/*.{ts,tsx}!",
        "test/**/*.{ts,tsx,mjs}"
      ],
      "vitest": false
    },
    "packages/agent-executor": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        "src/worker-entry.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "test/**/*.{ts,tsx,mjs}"
      ],
      "vitest": false,
      "ignoreIssues": {
        // tsx is loaded only when the managed executor runs workspace TypeScript sources.
        "src/managed-executor.ts": ["unlisted"],
        // taskkill is a Windows system executable, not an npm binary.
        "src/process-tree.ts": ["binaries"]
      }
    },
    "packages/agent-teams": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "test/**/*.{ts,tsx,mjs}"
      ],
      "vitest": false
    },
    "packages/cli": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        "src/daemon-entry.ts!",
        "src/update-awareness-worker.ts!",
        "skills/acpus/workflows/**/*.ts!",
        "test/fixtures/**/*.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "test/**/*.ts",
        "skills/acpus/workflows/**/*.ts!"
      ],
      "vitest": false,
      "ignoreIssues": {
        // tsx is used only by the workspace source-mode daemon branch.
        "src/daemon/client.ts": ["unlisted"],
        // These modules are loaded by path and their default exports are the
        // workflow compiler contract, not statically imported symbols.
        "skills/acpus/workflows/**/workflow.ts": ["exports"],
        "test/fixtures/**/*.workflow.ts": ["exports"]
      }
    },
    "packages/dsh": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        // The Agent launch resolves this executable by path at runtime.
        "src/host/dsh-acp-agent-bin.ts!",
        // TypeScript resolves this import through the generated declaration,
        // so list the runtime artifact explicitly to check its dependencies.
        "src/remote/generated.js!"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "test/**/*.{ts,tsx,mjs}"
      ],
      "vitest": false,
      // The ! suffix limits these exceptions to the production-only strict graph.
      "ignoreDependencies": [
        // Public declaration dependency erased from runtime output.
        "@acpus/expression!",
        // Slot prop types remain in public declarations but are erased from the Client bundle.
        "@deepseek-ai/dsh-client-ui-slots!",
        // Type augmentation needed only while compiling the Agent executable.
        "@deepseek-ai/dsh-agent!",
        // Loader used only by the workspace source-mode Agent branch.
        "tsx!"
      ],
      "ignoreIssues": {
        // Canonical generated artifacts intentionally expose one value as
        // both a named export and the default export.
        "src/remote/generated.d.ts": ["duplicates"],
        "src/remote/generated.js": ["duplicates"]
      }
    },
    "packages/loader": {
      "entry": ["test/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "vitest": false,
      // These are resolved from the string-driven facade target map.
      "ignoreDependencies": [
        "@acpus/core",
        "@acpus/expression",
        "@acpus/tasks"
      ]
    },
    "packages/owned-process": {
      "entry": ["test/**/*.{test,test-d}.{ts,tsx}"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "vitest": false,
      "ignoreIssues": {
        // taskkill.exe is a Windows system executable, not an npm binary.
        "src/node.ts": ["binaries"]
      }
    },
    "packages/runtime": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        "src/execution/task-process-entry.ts!",
        "test/fixtures/**/*.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "vitest": false,
      "ignoreIssues": {
        // tsx is used by the source-mode task subprocess branch.
        "src/execution/task-process.ts": ["unlisted", "binaries"],
        // taskkill is a Windows system executable, not an npm binary.
        "src/hooks/runner.ts": ["binaries"],
        // Fixture modules are compiled from paths and may export reusable test
        // definitions without static imports from the runtime test process.
        "test/fixtures/**/*.workflow.ts": ["exports"]
      }
    },
    "packages/web": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        "scripts/build-static-viz.mjs",
        "src/client/main.tsx",
        "src/client/static-viz.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/client/**/*.{ts,tsx}!",
        "test/**/*.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "vite": false,
      "vitest": false
    },
    "packages/workflow-compiler": {
      "entry": [
        "test/**/*.{test,test-d}.{ts,tsx}",
        "src/compiler/compile-worker.ts!",
        "test/fixtures/**/*.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.{ts,mjs}"],
      "vitest": false,
      "ignoreIssues": {
        // tsx is used by the source-mode compiler worker branch.
        "src/compiler/worker.ts": ["unlisted"],
        // These modules are loaded from fixture paths; their exports are inputs
        // to the compiler rather than static callers.
        "test/fixtures/**/*.workflow.ts": ["exports"]
      }
    }
  }
}
