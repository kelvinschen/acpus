{
  "schemaVersion": "acpus.workflow/v1",
  "name": "realtime-loop-fanout-review",
  "description": "Short read-only review workflow for validating run worker state and realtime loop fanout monitor projection.",
  "root": "review_loop",
  "inputs": {
    "cwd": {
      "type": "path",
      "default": "."
    },
    "reviewGoal": {
      "type": "string",
      "default": "Review the run execution semantics and realtime loop fanout monitor changes. Focus on correctness, observability, and missing tests."
    },
    "reviewItems": {
      "type": "array<json>",
      "default": [
        {
          "id": "run-worker",
          "paths": [
            "src/commands/run.ts",
            "src/runtime/worker.ts",
            "src/run-index/read-write.ts"
          ],
          "focus": "background worker startup, foreground wait semantics, worker metadata, heartbeat, and single-worker guard"
        },
        {
          "id": "loop-monitor",
          "paths": [
            "src/runtime/stage-runner.ts",
            "src/projections/run-monitor.ts"
          ],
          "focus": "loop body fanout start/settle persistence and RunMonitorView loopFanoutLane projection"
        },
        {
          "id": "cli-tui-contract",
          "paths": [
            "src/commands/recover.ts",
            "src/commands/resume.ts",
            "src/tui/monitor-app.tsx",
            "specs/cli-spec.md",
            "specs/runtime-orchestrator-spec.md"
          ],
          "focus": "recover/resume command semantics, worker state display, and SPEC alignment"
        }
      ]
    }
  },
  "roles": {
    "aiden_reviewer": {
      "category": "review",
      "agent": "aiden",
      "mode": "readOnly"
    },
    "trae_reviewer": {
      "category": "review",
      "agent": "trae",
      "mode": "readOnly"
    }
  },
  "limits": {
    "stageTimeoutMinutes": 20
  },
  "stages": [
    {
      "id": "review_loop",
      "kind": "loop",
      "maxRounds": 1,
      "body": {
        "root": "parallel_review",
        "output": "parallel_review",
        "stages": [
          {
            "id": "parallel_review",
            "kind": "fanout",
            "items": {
              "source": "input.reviewItems"
            },
            "limits": {
              "maxConcurrency": 3,
              "maxFanoutItems": 3
            },
            "fanoutPolicy": {
              "allowPartial": true,
              "minCompletedRatio": 0.66,
              "maxBlockedItems": 2
            },
            "variables": [
              {
                "name": "reviewGoal",
                "source": "input.reviewGoal"
              },
              {
                "name": "item",
                "source": "item",
                "transform": [
                  {
                    "fn": "json"
                  }
                ]
              }
            ],
            "prompt": "You are doing one bounded read-only review lane for a short orchestrator validation run.\n\nGoal:\n${reviewGoal}\n\nReview item:\n${item}\n\nInspect only the listed paths. Return concise findings with severity and concrete file references. Prefer no more than 3 findings.",
            "laneGroups": [
              {
                "id": "reviewers",
                "mode": "all",
                "lanes": [
                  {
                    "id": "aiden",
                    "role": "aiden_reviewer",
                    "prompt": "Aiden lane. Review for CLI/runtime contract regressions, race conditions, and missing user-visible behavior checks.\n\nGoal:\n${reviewGoal}\n\nReview item:\n${item}\n\nKeep the answer concise."
                  },
                  {
                    "id": "trae",
                    "role": "trae_reviewer",
                    "prompt": "Trae lane. Review for deeper implementation risks, concurrency hazards, and monitor projection correctness.\n\nGoal:\n${reviewGoal}\n\nReview item:\n${item}\n\nKeep the answer concise."
                  }
                ]
              }
            ]
          }
        ]
      },
      "continueWhen": {
        "source": "loop.current.output.data.needsAnotherRound",
        "op": "eq",
        "value": true
      },
      "onExhausted": "blocked"
    },
    {
      "id": "gate",
      "kind": "gate",
      "dependsOn": [
        "review_loop"
      ]
    }
  ]
}
